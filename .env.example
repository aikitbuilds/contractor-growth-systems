# Stripe Configuration
VITE_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_SECRET_KEY=your_stripe_secret_key

# Email Configuration
VITE_EMAIL_FROM=your_email_address
VITE_EMAIL_SERVER_HOST=your_smtp_server
VITE_EMAIL_SERVER_PORT=587
VITE_EMAIL_SERVER_USER=your_smtp_username
VITE_EMAIL_SERVER_PASSWORD=your_smtp_password

# Database Configuration (PostgreSQL via SSH Tunnel)
# For development: Set up SSH tunnel and connect to localhost
# For production: Connect directly to localhost (app and DB on same server)
VITE_DB_HOST=localhost
VITE_DB_NAME=your_database_name
VITE_DB_USER=your_database_user
VITE_DB_PASSWORD=your_database_password
VITE_DB_PORT=5432
VITE_DB_SSL=false

# Other Environment Variables
NODE_ENV=development 