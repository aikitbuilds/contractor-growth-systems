FROM node:18-slim as build

WORKDIR /app

# Set environment variables to disable Rollup native extensions
ENV ROLLUP_NATIVE=0
ENV NODE_ENV=production

COPY package.json .
COPY package-lock.json* .
COPY .npmrc* .

# Use npm install with --ignore-scripts to skip problematic native extensions
RUN npm install --omit=optional --ignore-scripts

COPY . .

# Build with explicit environment variable overrides using plain JS
RUN npm install -g cross-env && \
    cross-env ROLLUP_NATIVE=0 NODE_OPTIONS="--max-old-space-size=4096" npm run build && \
    mkdir -p dist-server && \
    cp server-prod.js dist-server/server.js && \
    echo '{"type":"module"}' > dist-server/package.json

# Create production image
FROM node:18-slim

WORKDIR /app

# Set environment variables
ENV NODE_ENV=production

# Copy built files from build stage
COPY --from=build /app/dist ./dist
COPY --from=build /app/dist-server ./dist-server
COPY --from=build /app/package.json ./package.json

# Install only express and its dependencies - no build tools needed in production
RUN npm install --omit=dev express

EXPOSE 3000

# Run the production server - not vite
CMD ["node", "dist-server/server.js"] 